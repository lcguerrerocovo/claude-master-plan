direction: down

# --- Entry ---

start: "/master-plan" {
  shape: oval
  style.fill: "#e8f4fd"
}

route: "Path provided?" {
  shape: diamond
  style.fill: "#fff3cd"
}

start -> route

# --- Phase 1 (setup) ---

phase1: "Phase 1: Setup" {
  style.fill: "#f0fdf0"

  brainstorm: "Brainstorm\nvision & principles"
  aligned: "Aligned?" { shape: diamond }
  write: "Write master doc"

  brainstorm -> aligned
  aligned -> brainstorm: "refine"
  aligned -> write: "yes"
}

route -> phase1.brainstorm: "no"

# --- Artifacts ---

master_doc: "Master Doc" {
  shape: page
  style.fill: "#fffde7"
  style.stroke: "#f9a825"
  label: |md
    **Master Doc**
    - Vision & Principles
    - Design Spec (when needed)
    - Starting State
    - Previous Sessions
  |
}

phase1.write -> master_doc: "creates" {
  style.stroke: "#f9a825"
  style.stroke-dash: 3
}

# --- Phase 2 (session loop) ---

phase2: "Phase 2: Session Loop" {
  style.fill: "#fdf0f0"

  assess: "1. Assess\ngap to vision"
  converge: "2. Converged?" {
    shape: diamond
    style.fill: "#fff3cd"
  }
  propose: "3. Propose\nhighest-leverage step"
  parallel: "Parallel?" {
    shape: diamond
    style.fill: "#fff3cd"
  }
  seq_exec: "4a. Execute &\nverify (sequential)"
  par_exec: "4b. Dispatch\nworktree agents" {
    style.fill: "#e0f0ff"
  }
  merge: "Merge & verify"

  post_exec: "5. Post-Execution" {
    style.fill: "#e8f0fd"
    label: |md
      **5. Post-Execution**
      - Consistency check
      - Code review (every 5)
      - **Commit**
      - Bookkeeping
      - Doc coherence (every 5)
      - Handoff
    |
  }

  assess -> converge
  converge -> propose: "gap remains"
  propose -> parallel
  parallel -> seq_exec: "no"
  parallel -> par_exec: "yes"
  seq_exec -> post_exec
  par_exec -> merge
  merge -> post_exec
}

route -> phase2.assess: "yes"

# --- Artifact connections ---

phase2.assess -> master_doc: "reads" {
  style.stroke: "#f9a825"
  style.stroke-dash: 3
}

phase2.post_exec -> master_doc: "updates" {
  style.stroke: "#f9a825"
}

session_plan: "Session Plan" {
  shape: page
  style.fill: "#fffde7"
  style.stroke: "#f9a825"
  label: |md
    **Session Plan**
    - Scope & Approach
    - Verification Criteria
    - Post-execution Checklist
  |
}

phase2.seq_exec -> session_plan: "creates" {
  style.stroke: "#f9a825"
  style.stroke-dash: 3
}

phase2.par_exec -> session_plan: "creates" {
  style.stroke: "#f9a825"
  style.stroke-dash: 3
}

# --- Convergence exit ---

done: "Done" {
  shape: oval
  style.fill: "#d4edda"
}

phase2.converge -> done: "vision met"

# --- Loop back ---

phase2.post_exec -> phase2.assess: "/clear + next session" {
  style.stroke-dash: 3
}
